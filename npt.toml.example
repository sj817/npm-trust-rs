# npt.toml — default binding rules for `npt` (npm Trusted Publishing manager).
# Copy to `npt.toml` and edit. All fields are optional. Used by the wizard and by
# the batch subcommands (scan/sync/audit).

[defaults]
# Workflow filename convention. `npt` derives the target binding as
#   github:<owner/repo>@<workflow>
# where <owner/repo> comes from each package.json `repository` field.
workflow = "publish.yml"

# Optional CI environment claim added to every binding (GitHub `environment`).
# environment = "release"

# Allowed actions on the trusted-publisher config. At least one is required by npm
# (configs created after 2026-05-20 must specify one). Defaults: publish only.
allow_publish = true
allow_stage_publish = false

# Default GitHub org/user for `npt scan --user` (so you can omit --org).
# org = "sj817"

# ---------------------------------------------------------------------------
# Per-package overrides / explicit expectations (used for mapping exceptions
# and by `npt audit`). Repeat the [[package]] block per package.
# ---------------------------------------------------------------------------

# [[package]]
# name = "@my-scope/special"
# repository = "my-org/special-repo"   # override the package.json repository mapping
# workflow = "release.yml"             # override the default workflow file
# environment = "production"

# [[package]]
# name = "@my-scope/legacy"
# ignore = true                        # audit/sync skip this package entirely
